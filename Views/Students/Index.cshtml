@model IEnumerable<StudentAdoNet.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Registered Students</h1>
    <a asp-action="Create" class="btn btn-primary">Register New Student</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No students are registered yet.
        <a asp-action="Create" class="alert-link">Register the first student</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.Course</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@student.Id"
                               class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
